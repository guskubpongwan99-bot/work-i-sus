        List<Question> plant = new ArrayList<>();
        plant.add(new Question("Which fruit is known as the King of Fruits?", 2, "Mango", "Pomelo", "Durian", "Rambutan"));
        plant.add(new Question("Which fruit is known as the Queen of Fruits?", 0, "Mangosteen", "Longan", "Lychee", "Rose apple"));
