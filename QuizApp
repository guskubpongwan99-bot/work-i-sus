        general.add(new Question("What is 12 x 12?", 0, "144", "124", "132", "154"));
        general.add(new Question("What is the largest continent in the world?", 2, "Africa", "North America", "Asia", "Europe"));
        categories.put("General Knowledge", general);

        List<Question> sea = new ArrayList<>();
