package com.mycompany.quizapp;

/**
 *
 * @author user
 */
import javax.swing.*;
import java.awt.*;
import java.util.*;
import java.util.List;
import static javax.swing.WindowConstants.EXIT_ON_CLOSE;

public class QuizApp extends JFrame {

    static class Question {
        String text;
        String[] choices;
        int answer; // index 0-3
        Question(String text, int answer, String... choices) {
            this.text = text;
            this.answer = answer;
            this.choices = choices;
        }
    }

    private final Font FONT = new Font("Tahoma", Font.PLAIN, 18);
    private final Font TITLE = new Font("Tahoma", Font.BOLD, 24);

    private final CardLayout cards = new CardLayout();
    private final JPanel root = new JPanel(cards);

    // quiz widgets
    private final JLabel categoryLabel = new JLabel("", SwingConstants.CENTER);
    private final JLabel progressLabel = new JLabel("", SwingConstants.CENTER);
    private final JTextArea questionArea = new JTextArea();
    private final JRadioButton[] options = new JRadioButton[4];
    private final ButtonGroup group = new ButtonGroup();
    private final JButton nextButton = new JButton("Next Question");
    private final JLabel resultLabel = new JLabel("", SwingConstants.CENTER);

    private List<Question> current;
    private String currentName;
    private int index, score;

    private final Map<String, List<Question>> categories = new LinkedHashMap<>();

    public QuizApp() {
        super("Knowledge Quiz");
        buildQuestions();
        root.add(buildMenu(), "menu");
        root.add(buildQuiz(), "quiz");
        root.add(buildResult(), "result");
        add(root);
        setDefaultCloseOperation(EXIT_ON_CLOSE);
        setSize(640, 460);
        setLocationRelativeTo(null);
    }

