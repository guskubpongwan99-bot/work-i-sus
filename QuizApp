    }

    private JPanel buildMenu() {
        JPanel p = new JPanel(new BorderLayout(10, 20));
        p.setBorder(BorderFactory.createEmptyBorder(30, 50, 30, 50));
        JLabel title = new JLabel("Knowledge Quiz (10 questions per set)", SwingConstants.CENTER);
        title.setFont(TITLE);
        p.add(title, BorderLayout.NORTH);

        JPanel buttons = new JPanel(new GridLayout(3, 1, 0, 15));
        for (String name : categories.keySet()) {
            JButton b = new JButton(name);
            b.setFont(FONT);
            b.addActionListener(e -> startQuiz(name));
            buttons.add(b);
        }
        p.add(buttons, BorderLayout.CENTER);
        return p;
    }

    private JPanel buildQuiz() {
        JPanel p = new JPanel(new BorderLayout(10, 10));
        p.setBorder(BorderFactory.createEmptyBorder(20, 30, 20, 30));

        JPanel top = new JPanel(new GridLayout(2, 1));
        categoryLabel.setFont(TITLE);
        progressLabel.setFont(FONT);
        top.add(categoryLabel);
        top.add(progressLabel);
        p.add(top, BorderLayout.NORTH);

        JPanel center = new JPanel(new BorderLayout(0, 15));
        questionArea.setFont(new Font("Tahoma", Font.BOLD, 20));
        questionArea.setEditable(false);
        questionArea.setLineWrap(true);
        questionArea.setWrapStyleWord(true);
        questionArea.setOpaque(false);
        center.add(questionArea, BorderLayout.NORTH);

        JPanel opts = new JPanel(new GridLayout(4, 1, 0, 8));
        for (int i = 0; i < 4; i++) {
            options[i] = new JRadioButton();
            options[i].setFont(FONT);
            group.add(options[i]);
            opts.add(options[i]);
        }
        center.add(opts, BorderLayout.CENTER);
        p.add(center, BorderLayout.CENTER);

        JPanel bottom = new JPanel();
        JButton menuBtn = new JButton("Back to Menu");
        menuBtn.setFont(FONT);
        menuBtn.addActionListener(e -> cards.show(root, "menu"));
        nextButton.setFont(FONT);
        nextButton.addActionListener(e -> next());
        bottom.add(menuBtn);
        bottom.add(nextButton);
        p.add(bottom, BorderLayout.SOUTH);
        return p;
    }

    private JPanel buildResult() {
        JPanel p = new JPanel(new BorderLayout(10, 20));
        p.setBorder(BorderFactory.createEmptyBorder(40, 40, 40, 40));
        resultLabel.setFont(TITLE);
        p.add(resultLabel, BorderLayout.CENTER);

        JPanel bottom = new JPanel();
        JButton again = new JButton("Play This Set Again");
        JButton menu = new JButton("Back to Menu");
        again.setFont(FONT);
        menu.setFont(FONT);
        again.addActionListener(e -> startQuiz(currentName));
        menu.addActionListener(e -> cards.show(root, "menu"));
        bottom.add(again);
        bottom.add(menu);
        p.add(bottom, BorderLayout.SOUTH);
        return p;
    }

    private void startQuiz(String name) {
        currentName = name;
        current = new ArrayList<>(categories.get(name));
        Collections.shuffle(current);
        index = 0;
        score = 0;
        categoryLabel.setText(name);
        showQuestion();
        cards.show(root, "quiz");
    }

    private void showQuestion() {
        Question q = current.get(index);
        progressLabel.setText("Question " + (index + 1) + " / " + current.size() + "   Score: " + score);
        questionArea.setText(q.text);
        group.clearSelection();
        for (int i = 0; i < 4; i++) {
            options[i].setText(q.choices[i]);
        }
        nextButton.setText(index == current.size() - 1 ? "Submit Answer" : "Next Question");
    }

    private void next() {
        int selected = -1;
        for (int i = 0; i < 4; i++) {
            if (options[i].isSelected()) selected = i;
        }
        if (selected == -1) {
            JOptionPane.showMessageDialog(this, "Please select an answer first.");
            return;
        }
        Question q = current.get(index);
        if (selected == q.answer) {
            score++;
            JOptionPane.showMessageDialog(this, "Correct!");
        } else {
            JOptionPane.showMessageDialog(this, "Wrong! The correct answer is: " + q.choices[q.answer]);
        }
        index++;
        if (index >= current.size()) {
            resultLabel.setText("<html><center>" + currentName + "<br>You scored " + score + " / " + current.size() + "</center></html>");
            cards.show(root, "result");
        } else {
            showQuestion();
        }
    }

    public static void main(String[] args) {
        SwingUtilities.invokeLater(() -> new QuizApp().setVisible(true));
    }
}
