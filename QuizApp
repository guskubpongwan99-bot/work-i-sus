        sea.add(new Question("Which sea creature has 8 arms?", 0, "Octopus", "Squid", "Starfish", "Jellyfish"));
        sea.add(new Question("What type of animal is a whale?", 2, "Fish", "Reptile", "Mammal", "Amphibian"));
        sea.add(new Question("What type of living thing is coral?", 3, "Plant", "Rock", "Algae", "Animal"));
        sea.add(new Question("Which sea is so salty that people float easily in it?", 0, "Dead Sea", "Red Sea", "Andaman Sea", "Songkhla Lake"));
        sea.add(new Question("Ocean tides are mainly caused by the gravitational pull of what?", 1, "The Sun", "The Moon", "Mars", "The wind"));
        sea.add(new Question("What is the deepest ocean trench?", 2, "Java Trench", "Tonga Trench", "Mariana Trench", "Philippine Trench"));
        sea.add(new Question("How many arms does a starfish usually have?", 1, "4", "5", "6", "8"));
        sea.add(new Question("What type of fish is a shark?", 3, "Bony fish", "Jawless fish", "Freshwater fish", "Cartilaginous fish"));
        sea.add(new Question("In which country is the largest coral reef in the world?", 0, "Australia", "Thailand", "Japan", "Brazil"));
