package com.mycompany.javaapplication23; 


import java.util.Scanner; 


public class JavaApplication23 { 


    public static void main(String[] args) { 
    //  (main method) 
    
        Scanner sc = new Scanner(System.in); 
        
        
        double[] prices = {45, 50, 60, 55, 50, 55}; 
       
        
        int[] quantities = new int[6]; 
        
        
        String[][] menu = {
            {"1. Americano", "45 THB"},
            {"2. Cappuccino", "50 THB"},
            {"3. Mocha", "60 THB"},
            {"4. Cocoa", "55 THB"},
            {"5. Green Tea", "50 THB"},
            {"6. Latte", "55 THB"},
            {"0. Exit/Checkout", ""}
        }; 
        

        while (true) { 
       
            System.out.println("=== Welcome to Coffee Shop ==="); 
            
            System.out.println("----- Menu -----"); 

            for (int i = 0; i < menu.length; i++) { 
            //  สำหรับไล่ดูแต่ละแถวของเมนู 
            
                for (int j = 0; j < menu[i].length; j++){ 
                // []  inner loop สำหรับไล่ดูแต่ละคอลัมน์ในแถวนั้นๆ
                
                    System.out.print(menu[i][j] + "\t"); 
                   
                }
                
                System.out.println(); 
     
            }

            System.out.print("Choose your menu: "); 
            
            int Choose = sc.nextInt(); 

            if (Choose == 0) {            
            
                break; 
              
            }

            if (Choose >= 1 && Choose <= 6) { 
            
                int menuIndex = Choose - 1; 
                
                System.out.println("Selected: " + menu[menuIndex][0]); 
                
                System.out.print("Enter quantity: "); 
                
                int qty = sc.nextInt(); 
                
                quantities[menuIndex] += qty; 
       

            } else { 
            
                System.out.println("Invalid menu option. Please try again."); 
                
                System.out.println();
                
                continue; 
                
            }

            sc.nextLine(); 
            
            
            System.out.print("Do you want to order more? (Y/N): "); 
           
            
            String continueOrder = sc.nextLine(); 
            // medthod sc.nextLine() รับคำตอบ Y/N มาเก็บใน continueOrder

            if (continueOrder.equalsIgnoreCase("N")) { 
            // medthod continueOrder.equalsIgnoreCase() เช็คว่าผู้ใช้พิมพ์ N หรือ n หรือไม่
            
                break; 

            }
            
            System.out.println(); 
            
        }

        double subtotal = 0.0; 
        
        System.out.println("\n================================="); 
        
        System.out.println("--------- Order Summary ---------"); 
      
        for (int i = 0; i < quantities.length; i++) { 
        
            if (quantities[i] > 0) { 
            
                double itemTotal = quantities[i] * prices[i]; 
               
                subtotal += itemTotal; 
                
                System.out.println(menu[i][0] + " x " + quantities[i] + " = " + itemTotal + " THB"); 
                
            }
        }

        double discount = subtotal * 0.10; 
       
        double finalTotal = subtotal - discount; 
      
        System.out.println("---------------------------------"); 
        
        System.out.println("Subtotal: " + subtotal + " THB"); 
        
        System.out.println("Discount (10%): -" + discount + " THB");
        
        System.out.println("Total Amount: " + finalTotal + " THB"); 
        
        System.out.println("================================="); 

        sc.close(); 
        
        
    } 
   
    
} 
