package com.mycompany.cafe2;

import java.util.Scanner;

public class Cafe2 {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        // array เก็บข้อมูลนิสิต: [0] = ชื่อ, [1] = รหัส
        String[] student = {"Your Name", "6830250056"};

        // array เก็บชื่อเมนูและราคาเมนู (index ตรงกัน)
        String[] menuNames = {"Americano", "Cappuccino", "Mocha", "Cocoa", "Green Tea", "Latte"};
        double[] menuPrices = {45, 50, 60, 55, 50, 55};

        // แสดงเมนู
        System.out.println("----- Menu -----");
        for (int i = 0; i < menuNames.length; i++) {
            System.out.println((i + 1) + ". " + menuNames[i] + "\t" + menuPrices[i] + " THB");
        }

        System.out.print("Choose your menu (1-6): ");
        int choice = sc.nextInt();
        System.out.print("Enter number of cups: ");
        int cups = sc.nextInt();

        // ดึงเลขจากรหัสนิสิต
        String id = student[1];
        int lastTwo = Integer.parseInt(id.substring(id.length() - 2));   // 56
        int lastDigit = Integer.parseInt(id.substring(id.length() - 1)); // 6

        String menuName = menuNames[choice - 1];
        double price = menuPrices[choice - 1] + (lastTwo * 2);  // ราคาเมนู + (56 * 2)
        int quantity = cups + (lastDigit % 5);                  // จำนวนแก้ว + (6 % 5)

        System.out.println();
        System.out.println("Student Name : " + student[0]);
        System.out.println("Student ID   : " + student[1]);

        CoffeeOrder order = new CoffeeOrder(menuName, price, quantity);
        order.displayReceipt();

        sc.close();
    }
}
